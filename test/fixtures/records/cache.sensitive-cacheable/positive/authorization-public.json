{
  "title": "HTML with authorization and a public cache",
  "input": {
    "url": "https://app.test/account",
    "requestHeaders": [
      {
        "name": "authorization",
        "value": "Bearer abc"
      }
    ],
    "responseHeaders": [
      {
        "name": "content-type",
        "value": "text/html; charset=utf-8"
      },
      {
        "name": "cache-control",
        "value": "public, max-age=600"
      }
    ]
  },
  "expect": [
    {
      "subject": "GET /account"
    }
  ]
}
