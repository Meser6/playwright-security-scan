{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pkg.invalid/schemas/run-report.schema.json",
  "title": "Run report",
  "description": "reports/pw-sec/report.json (02, chapter 6): the full result of one run, redacted (P-07).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "startedAt",
    "finishedAt",
    "mode",
    "shards",
    "authz",
    "attack",
    "pkgVersion",
    "playwrightVersion",
    "scope",
    "coverage",
    "findings",
    "resolved",
    "notCovered",
    "testsWithoutTraffic",
    "gate",
    "diagnostics",
    "outcome"
  ],
  "properties": {
    "schemaVersion": {
      "description": "Version 2 (02-REQ-06): without the env field of version 1.",
      "const": 2
    },
    "runId": {
      "type": "string"
    },
    "startedAt": {
      "type": "string"
    },
    "finishedAt": {
      "type": "string"
    },
    "mode": {
      "description": "Mode of the run; attack and attack-baseline add the ZAP active scan (19-REQ-01).",
      "enum": ["scan", "baseline", "attack", "attack-baseline"]
    },
    "shards": {
      "description": "Shards of a merged run (17-REQ-12); null for a run without shards.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "missing", "list"],
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 1
            },
            "missing": {
              "description": "Numbers of the missing shards.",
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "list": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/shardInfo"
              }
            }
          }
        }
      ]
    },
    "authz": {
      "description": "Authorization tests of the run (18-REQ-21); null when they are off.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/authzSummary"
        }
      ]
    },
    "attack": {
      "description": "The ZAP active scan of an attack run (19-REQ-10); null in the other modes.",
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/attackSummary" }]
    },
    "pkgVersion": {
      "type": "string"
    },
    "playwrightVersion": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origins"],
      "properties": {
        "origins": {
          "description": "Scope origins and patterns.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "coverage": {
      "$ref": "common.schema.json#/$defs/coverage"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/classifiedFinding"
      }
    },
    "resolved": {
      "description": "Baseline entries not seen although their scope was covered (08-REQ-05).",
      "type": "array",
      "items": {
        "$ref": "#/$defs/entryRef"
      }
    },
    "notCovered": {
      "description": "Baseline entries whose scope the run did not cover (08-REQ-05).",
      "type": "array",
      "items": {
        "$ref": "#/$defs/entryRef"
      }
    },
    "testsWithoutTraffic": {
      "description": "Tests with no in-scope response (05-REQ-02), at most 50.",
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "common.schema.json#/$defs/testContextRef"
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minSeverity", "minConfidence", "failed", "blocking"],
      "properties": {
        "minSeverity": {
          "$ref": "common.schema.json#/$defs/severity"
        },
        "minConfidence": {
          "$ref": "common.schema.json#/$defs/confidence"
        },
        "failed": {
          "type": "boolean"
        },
        "blocking": {
          "description": "Fingerprints that fail the run.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/diagnostic"
      }
    },
    "outcome": {
      "$ref": "outcome.schema.json"
    }
  },
  "$defs": {
    "attackSummary": {
      "title": "AttackSummary",
      "description": "The ZAP active scan of an attack run (19-REQ-10, 19 chapter 11a).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "zap",
        "zapVersion",
        "role",
        "origins",
        "methods",
        "durationSeconds",
        "requests",
        "templates",
        "alerts",
        "budget",
        "budgetExceeded",
        "completed",
        "rules"
      ],
      "properties": {
        "engine": { "const": "zap" },
        "zap": {
          "description": "docker: a container started by the package; url: attack.zapUrl.",
          "enum": ["docker", "url"]
        },
        "zapVersion": { "oneOf": [{ "type": "null" }, { "type": "string" }] },
        "role": { "description": "Role of the scan session, or anonymous.", "type": "string" },
        "origins": {
          "description": "attack.allowedOrigins.",
          "type": "array",
          "items": { "type": "string" }
        },
        "methods": {
          "description": "attack.methods.",
          "type": "array",
          "items": { "type": "string" }
        },
        "durationSeconds": { "type": "integer", "minimum": 0 },
        "requests": {
          "description": "Requests of ZAP: the sent templates and the messages of the active scan.",
          "type": "integer",
          "minimum": 0
        },
        "templates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sent", "failed"],
          "properties": {
            "sent": { "type": "integer", "minimum": 0 },
            "failed": { "type": "integer", "minimum": 0 }
          }
        },
        "alerts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mapped", "falsePositive", "passive", "off"],
          "properties": {
            "mapped": { "type": "integer", "minimum": 0 },
            "falsePositive": { "type": "integer", "minimum": 0 },
            "passive": { "type": "integer", "minimum": 0 },
            "off": { "type": "integer", "minimum": 0 }
          }
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxRequests", "maxDurationMinutes", "maxRps"],
          "properties": {
            "maxRequests": { "type": "integer", "minimum": 1 },
            "maxDurationMinutes": { "type": "number", "exclusiveMinimum": 0 },
            "maxRps": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "budgetExceeded": { "type": "boolean" },
        "completed": {
          "description": "The scan finished within the budget (19-REQ-09).",
          "type": "boolean"
        },
        "rules": {
          "description": "Descriptions of the zap.* rules of the findings (19 chapter 11a).",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "description", "solution", "helpUri", "cwe", "owasp"],
            "properties": {
              "id": { "type": "string", "pattern": "^zap\\.[0-9]+$" },
              "name": { "type": "string" },
              "description": { "type": "string", "maxLength": 2000 },
              "solution": { "type": "string", "maxLength": 2000 },
              "helpUri": { "type": "string" },
              "cwe": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
              "owasp": { "oneOf": [{ "type": "null" }, { "type": "string" }] }
            }
          }
        }
      }
    },
    "authzSummary": {
      "title": "AuthzSummary",
      "description": "Roles, replays and the role matrix of the authorization tests (18-REQ-21).",
      "type": "object",
      "additionalProperties": false,
      "required": ["roles", "templates", "replays", "budget", "skipped", "matrix"],
      "properties": {
        "roles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "projects", "level"],
            "properties": {
              "name": { "type": "string" },
              "projects": { "type": "array", "items": { "type": "string" } },
              "level": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }] }
            }
          }
        },
        "templates": {
          "description": "Request templates after the deduplication by endpoint key and project.",
          "type": "integer",
          "minimum": 0
        },
        "replays": {
          "description": "Requests sent.",
          "type": "integer",
          "minimum": 0
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxRequests", "used", "exceeded"],
          "properties": {
            "maxRequests": { "type": "integer", "minimum": 1 },
            "used": { "type": "integer", "minimum": 0 },
            "exceeded": { "type": "boolean" }
          }
        },
        "skipped": {
          "description": "Replays not sent, by reason (18, chapter 12a).",
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "matrix": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["endpointKey", "from", "as", "result"],
            "properties": {
              "endpointKey": { "type": "string" },
              "from": { "description": "Role of the original request.", "type": "string" },
              "as": {
                "description": "Role of the replay; anonymous without a session.",
                "type": "string"
              },
              "result": { "enum": ["enforced", "bypassed", "different", "public", "skipped"] },
              "reason": { "type": "string" },
              "similarity": { "type": "number", "minimum": 0, "maximum": 1 },
              "fingerprint": { "type": "string" }
            }
          }
        }
      }
    },
    "classifiedFinding": {
      "title": "ClassifiedFinding",
      "description": "A finding of the run with its classification against the baseline (08, chapter 3).",
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/findingFields"
        },
        {
          "type": "object",
          "required": ["classification", "blocking"],
          "properties": {
            "classification": {
              "enum": ["new", "accepted", "false-positive", "wontfix", "expired"]
            },
            "blocking": {
              "description": "The finding fails the run.",
              "type": "boolean"
            },
            "baseline": {
              "description": "The baseline entry of the finding, if any.",
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "addedAt"],
              "properties": {
                "status": {
                  "enum": ["accepted", "false-positive", "wontfix"]
                },
                "note": {
                  "type": "string"
                },
                "until": {
                  "$ref": "common.schema.json#/$defs/isoDate"
                },
                "addedAt": {
                  "$ref": "common.schema.json#/$defs/isoDate"
                },
                "expiresInDays": {
                  "description": "Set when until is at most 14 days away (08-REQ-03).",
                  "type": "integer"
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false,
      "type": "object"
    },
    "entryRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fingerprint", "ruleId", "subject"],
      "properties": {
        "fingerprint": {
          "type": "string"
        },
        "ruleId": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        }
      }
    },
    "shardInfo": {
      "description": "One shard of a merged run (17-REQ-12).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "runId",
        "startedAt",
        "finishedAt",
        "tests",
        "findings",
        "responses",
        "buildUrl"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 1
        },
        "runId": {
          "type": "string"
        },
        "startedAt": {
          "type": "string"
        },
        "finishedAt": {
          "type": "string"
        },
        "tests": {
          "description": "Tests of the shard.",
          "$ref": "common.schema.json#/$defs/count"
        },
        "findings": {
          "description": "Findings of the shard after deduplication.",
          "$ref": "common.schema.json#/$defs/count"
        },
        "responses": {
          "description": "Responses in scope.",
          "$ref": "common.schema.json#/$defs/count"
        },
        "buildUrl": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
