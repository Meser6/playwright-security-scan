+// @ts-check
+// Config of playwright-security-scan. Every option: https://github.com/Meser6/playwright-security-scan/blob/main/docs/configuration.md
+// Objects are merged with the defaults; an array you set replaces the default one.
+const { defineSecurityConfig } = require('playwright-security-scan/config');
+
+module.exports = defineSecurityConfig({
+  // Which traffic is scanned.
+  scope: {
+    // Origins scanned besides the use.baseURL origins, e.g. your API.
+    origins: [],
+    // Origins never scanned, even when they match.
+    exclude: [],
+    // Playwright projects whose tests are scanned: 'all' or a list of names.
+    projects: 'all',
+    // Scan the calls of the request fixture (API tests).
+    api: true,
+  },
+
+  // The passive rules; turn one off with rules: { "<rule id>": "off" }.
+  rules: {
+    // 'recommended', 'strict' (every rule, higher severities) or 'minimal'.
+    preset: 'recommended',
+  },
+
+  // Which new findings fail the scan; findings in the baseline never do.
+  gate: {
+    // Lowest severity of a new finding that fails the scan.
+    minSeverity: 'medium',
+    // Lowest confidence of a new finding that fails the scan.
+    minConfidence: 'medium',
+    // Fail when no response was in scope (a wrong scope scans nothing).
+    failOnNoTraffic: true,
+  },
+
+  // The baseline file you commit.
+  baseline: {
+    // Relative to the Playwright config.
+    path: 'security-baseline.json',
+    // Require a note on every accepted entry.
+    requireNote: false,
+  },
+
+  // Reports of a run.
+  report: {
+    // Directory of report.html, report.json, results.sarif and junit.xml (do not commit it),
+    // relative to the Playwright config.
+    dir: 'reports/pw-sec',
+  },
+});
