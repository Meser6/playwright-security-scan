{
  "title": "passwordHash in a profile",
  "input": {
    "source": "api",
    "resourceType": "api",
    "url": "https://app.test/api/me",
    "responseHeaders": [
      {
        "name": "content-type",
        "value": "application/json"
      }
    ],
    "body": "{\"id\":1,\"profile\":{\"passwordHash\":\"$2b$10$abc\"}}"
  },
  "expect": [
